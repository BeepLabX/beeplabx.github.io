---
import { profile, githubUrl } from '../config/profile';
---

<section id="intro" class="hero snap-panel" aria-labelledby="hero-title">
  <div class="wrap hero__inner">
    <div class="hero__top label"><span>DEVELOPER PORTFOLIO</span><span class="hero__hint">이름을 눌러 보세요</span><span>WEB APPS / GAMES</span></div>
    <div class="hero__grid">
      <div class="hero__copy">
        <h1 id="hero-title">{profile.brand}<span aria-hidden="true">.</span></h1>
        <div class="hero__lede">
          <h2>웹을 만들고,<br />게임을 만듭니다.</h2>
          <p class="hero__intro">캐릭터를 만드는 Totillu부터<br />빛을 다루는 게임 Lamplighter까지.</p>
          <div class="hero__links">
            <a class="hero__cta" href="#works" data-magnet>프로젝트 보기 <span aria-hidden="true">↘</span></a>
            <a href={githubUrl} target="_blank" rel="noopener">GitHub <span aria-hidden="true">↗</span><span class="sr-only"> (새 탭)</span></a>
          </div>
        </div>
      </div>
      <div class="hero__art">
        <img src="/brand-hero.webp" width="512" height="512" alt="BeepLabX BX 로고" fetchpriority="high" />
      </div>
    </div>
    <div class="hero__bottom mono"><span>BeepLabX / Selected projects</span><a href="#works">SCROLL TO EXPLORE <span aria-hidden="true">↓</span></a></div>
  </div>
</section>

<style>
  .hero { position: relative; isolation: isolate; min-height: calc(100svh - var(--footer-h)); padding-top: var(--header-h); background: radial-gradient(ellipse 70% 60% at 30% 40%, rgb(125 171 255 / .07), transparent 70%), var(--ink); }
  .hero__inner { min-height: calc(100svh - var(--header-h) - var(--footer-h)); display: flex; flex-direction: column; padding-block: 32px; }
  .hero__top, .hero__bottom { display: flex; justify-content: space-between; gap: 20px; }
  .hero__top { font-size: .65rem; letter-spacing: .12em; }
  .hero__hint { display: none; }
  :global(.fx) .hero__hint { display: inline; color: var(--lamp); animation: blink 2.4s 2s ease-in-out infinite; }
  .hero__grid { display: grid; grid-template-columns: 1.2fr 1fr; align-items: center; gap: 24px; flex: 1; padding-block: 40px; }
  h1 { font-size: clamp(3.8rem, 7.9vw, 7.5rem); font-weight: 550; letter-spacing: -.075em; white-space: nowrap; cursor: crosshair; }
  h1 span { color: var(--lamp); }
  /* The particles draw the heading; the text stays for reading. If they never start, it comes back. */
  :global(.fx) h1 { opacity: 0; animation: show .6s 3s forwards; }
  :global(.fx) h1:global(.is-particle) { animation: none; }
  h2 { font-family: var(--f-body); font-size: clamp(1.7rem, 3.3vw, 3rem); font-weight: 500; line-height: 1.35; letter-spacing: -.05em; }
  .hero__lede { margin-top: 34px; }
  .hero__lede > *, .hero__art, .hero__top, .hero__bottom { animation: rise 1s cubic-bezier(.2,.8,.2,1) both; }
  .hero__lede > :nth-child(2) { animation-delay: .12s; }
  .hero__lede > :nth-child(3) { animation-delay: .24s; }
  .hero__art { animation-delay: .3s; animation-name: art-in; animation-duration: 1.4s; }
  .hero__top, .hero__bottom { animation-delay: .5s; animation-name: show; }
  .hero__intro { margin-top: 24px; color: var(--dim); font-size: 1rem; line-height: 1.8; }
  .hero__links { display: flex; align-items: center; flex-wrap: wrap; gap: 32px; margin-top: 32px; font-size: .9rem; }
  .hero__links a { display: inline-flex; align-items: center; gap: 24px; min-height: 48px; text-decoration: none; }
  .hero__cta { border-bottom: 1px solid var(--paper); transition: translate .4s var(--spring), color .2s; }
  .hero__links a:hover { color: var(--lamp); }
  .hero__art { position: relative; }
  .hero__art img { width: 100%; max-width: 480px; margin-inline: auto; animation: float 7s ease-in-out infinite; }
  .hero__bottom { padding-top: 20px; border-top: 1px solid var(--line); color: var(--dim); font-size: .65rem; }
  .hero__bottom a { text-decoration: none; min-height: 32px; }
  .hero__bottom a span { display: inline-block; animation: nudge 1.8s ease-in-out infinite; }

  /* Scroll-linked exit (browsers without scroll timelines simply skip it). */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero { view-timeline: --hero block; }
      .hero__lede { animation: lede-out linear both; animation-timeline: --hero; animation-range: exit 0% exit 70%; }
      .hero__grid .hero__art { animation: art-in 1.4s .3s cubic-bezier(.2,.8,.2,1) both, art-out linear both; animation-timeline: auto, --hero; animation-range: normal, exit 0% exit 90%; }
    }
  }
  @keyframes rise { from { opacity: 0; transform: translateY(32px); filter: blur(8px); } }
  @keyframes show { from { opacity: 0; } to { opacity: 1; } }
  @keyframes art-in { from { opacity: 0; scale: .7; rotate: -12deg; filter: blur(12px); } }
  @keyframes art-out { from { transform: none; opacity: 1; } to { transform: translateY(-25%) rotate(14deg) scale(.75); opacity: 0; } }
  @keyframes lede-out { from { transform: none; opacity: 1; } to { transform: translateY(-40%); opacity: 0; } }
  @keyframes float { 50% { translate: 0 -14px; rotate: 2deg; } }
  @keyframes nudge { 50% { translate: 0 4px; } }
  @keyframes blink { 50% { opacity: .35; } }

  @media (max-width: 760px) {
    .hero__inner { padding-block: 24px; }
    .hero__top span:last-child { display: none; }
    .hero__grid { grid-template-columns: 1fr; gap: 16px; padding-block: 32px 24px; }
    h1 { font-size: clamp(3.2rem, 12.8vw, 6rem); }
    .hero__lede { margin-top: 24px; }
    h2 { font-size: 1.85rem; }
    .hero__intro { margin-top: 16px; font-size: .9rem; }
    .hero__links { margin-top: 20px; }
    .hero__art { width: min(52vw, 240px); justify-self: end; }
    .hero__bottom { font-size: .55rem; align-items: center; }
  }
  /* Laptop heights (≈720–860px) too: otherwise the bottom link slides under the fixed footer. */
  @media (max-height: 860px) and (min-width: 761px) {
    .hero__inner { padding-block: 20px; }
    .hero__grid { padding-block: 24px; }
    .hero__lede { margin-top: 20px; }
    .hero__art img { max-width: 360px; }
  }
</style>
