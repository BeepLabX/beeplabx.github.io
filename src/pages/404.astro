---
import Base from '../layouts/Base.astro';
---

<Base title="페이지를 찾을 수 없음">
  <section class="wrap missing">
    <p class="label">404</p>
    <h1>페이지를 찾을 수 없어요.</h1>
    <p>주소가 바뀌었거나 없는 페이지입니다.</p>
    <p class="missing__links">
      <a class="btn btn--lamp" href="/">처음으로</a>
      <button class="btn" type="button" data-quicknav-open>메뉴 열기</button>
    </p>
  </section>
</Base>

<style>
  .missing {
    min-height: 70svh;
    padding-top: calc(var(--header-h) + 80px);
  }

  .missing h1 {
    margin: 1rem 0 1.2rem;
    font-size: clamp(2rem, 6vw, 3.6rem);
    max-width: 14em;
  }

  .missing p:not(.label) {
    color: var(--dim);
  }

  .missing__links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 2rem;
  }
</style>
